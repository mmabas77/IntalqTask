<div class="row justify-content-center">
    <div class="col-md-10">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1 class="h3">
                <i class="fas fa-question-circle me-2"></i>Question Details
            </h1>
            <div class="btn-group">
                <a href="/questions/<%= question._id %>/edit" class="btn btn-primary">
                    <i class="fas fa-edit me-2"></i>Edit Question
                </a>
                <a href="/questions/chapter/<%= question.chapterId._id %>" class="btn btn-secondary">
                    <i class="fas fa-arrow-left me-2"></i>Back to Chapter
                </a>
            </div>
        </div>

        <!-- Question Information -->
        <div class="card mb-4">
            <div class="card-header">
                <h5 class="card-title mb-0">
                    <i class="fas fa-info-circle me-2"></i>Question Information
                </h5>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-6">
                        <p><strong>Course:</strong> <%= question.chapterId.courseId.name %></p>
                        <p><strong>Chapter:</strong> <%= question.chapterId.chapterNumber %></p>
                        <p><strong>Objective:</strong> 
                            <% if (question.objective === 'reminding') { %>
                                <span class="badge bg-info">
                                    <i class="fas fa-brain me-1"></i>Reminding
                                </span>
                            <% } else if (question.objective === 'understanding') { %>
                                <span class="badge bg-success">
                                    <i class="fas fa-lightbulb me-1"></i>Understanding
                                </span>
                            <% } else if (question.objective === 'creativity') { %>
                                <span class="badge bg-warning">
                                    <i class="fas fa-magic me-1"></i>Creativity
                                </span>
                            <% } %>
                        </p>
                    </div>
                    <div class="col-md-6">
                        <p><strong>Difficulty:</strong> 
                            <span class="badge bg-<%= question.difficulty === 'simple' ? 'success' : question.difficulty === 'difficult' ? 'danger' : 'warning' %>">
                                <%= question.difficulty.charAt(0).toUpperCase() + question.difficulty.slice(1) %>
                            </span>
                        </p>
                        <p><strong>Created:</strong> <%= new Date(question.createdAt).toLocaleDateString() %></p>
                        <p><strong>Last Modified:</strong> <%= new Date(question.updatedAt).toLocaleDateString() %></p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Question Content -->
        <div class="card mb-4">
            <div class="card-header">
                <h5 class="card-title mb-0">
                    <i class="fas fa-question me-2"></i>Question
                </h5>
            </div>
            <div class="card-body">
                <div class="question-text fs-5 mb-4">
                    <%= question.questionText %>
                </div>
                
                <!-- Answer Options -->
                <div class="options">
                    <h6 class="mb-3">Answer Options:</h6>
                    <% if (question.choices && question.choices.length > 0) { %>
                        <% question.choices.forEach((choice, index) => { %>
                            <div class="form-check mb-3 p-3 rounded <%= index == question.correctAnswer ? 'bg-success bg-opacity-10 border border-success' : 'bg-light' %>">
                                <input class="form-check-input" type="radio" disabled <%= index == question.correctAnswer ? 'checked' : '' %>>
                                <label class="form-check-label fs-6 <%= index == question.correctAnswer ? 'text-success fw-bold' : '' %>">
                                    <strong><%= String.fromCharCode(65 + index) %>.</strong> <%= choice %>
                                    <% if (index == question.correctAnswer) { %>
                                        <i class="fas fa-check-circle text-success ms-2"></i>
                                        <span class="badge bg-success ms-2">Correct Answer</span>
                                    <% } %>
                                </label>
                            </div>
                        <% }); %>
                    <% } else { %>
                        <div class="alert alert-warning">
                            <i class="fas fa-exclamation-triangle me-2"></i>
                            No answer options available for this question.
                        </div>
                    <% } %>
                </div>
            </div>
        </div>

        <!-- Question Preview -->
        <div class="card mb-4">
            <div class="card-header">
                <h5 class="card-title mb-0">
                    <i class="fas fa-eye me-2"></i>Exam Preview
                </h5>
            </div>
            <div class="card-body">
                <div class="exam-preview p-3 border rounded">
                    <div class="question-header mb-3">
                        <strong>Question 1</strong>
                        <span class="float-end text-muted">
                            [<%= question.objective.charAt(0).toUpperCase() + question.objective.slice(1) %> | 
                            Chapter <%= question.chapterId.chapterNumber %> | 
                            <%= question.difficulty.charAt(0).toUpperCase() + question.difficulty.slice(1) %>]
                        </span>
                    </div>
                    <div class="question-text mb-3">
                        <%= question.questionText %>
                    </div>
                    <% if (question.choices && question.choices.length > 0) { %>
                        <div class="options">
                            <% question.choices.forEach((choice, index) => { %>
                                <div class="form-check mb-2">
                                    <input class="form-check-input" type="radio" disabled>
                                    <label class="form-check-label">
                                        <strong><%= String.fromCharCode(65 + index) %>.</strong> <%= choice %>
                                    </label>
                                </div>
                            <% }); %>
                        </div>
                    <% } %>
                </div>
                <small class="text-muted">
                    <i class="fas fa-info-circle me-1"></i>
                    This is how the question will appear in an exam.
                </small>
            </div>
        </div>

        <!-- Action Buttons -->
        <div class="card">
            <div class="card-body">
                <div class="row">
                    <div class="col-md-4">
                        <a href="/questions/<%= question._id %>/edit" class="btn btn-primary w-100">
                            <i class="fas fa-edit me-2"></i>Edit Question
                        </a>
                    </div>
                    <div class="col-md-4">
                        <a href="/questions/chapter/<%= question.chapterId._id %>" class="btn btn-secondary w-100">
                            <i class="fas fa-list me-2"></i>View All Questions
                        </a>
                    </div>
                    <div class="col-md-4">
                        <form action="/questions/<%= question._id %>?_method=DELETE" method="POST" class="d-inline w-100">
                            <button type="submit" class="btn btn-danger w-100" onclick="return confirm('Are you sure you want to delete this question?')">
                                <i class="fas fa-trash me-2"></i>Delete Question
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>