<div class="row">
    <div class="col-12">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1 class="h3">
                <i class="fas fa-question-circle me-2"></i>
                Questions for <%= chapter.courseId.name %> - Chapter <%= chapter.chapterNumber %>
            </h1>
            <div class="btn-group">
                <a href="/questions/chapter/<%= chapter._id %>/create" class="btn btn-primary">
                    <i class="fas fa-plus me-2"></i>Add Question
                </a>
                <a href="/courses/<%= chapter.courseId._id %>" class="btn btn-secondary">
                    <i class="fas fa-arrow-left me-2"></i>Back to Course
                </a>
            </div>
        </div>

        <!-- Chapter Progress -->
        <div class="card mb-4">
            <div class="card-body">
                <div class="row">
                    <div class="col-md-3">
                        <div class="text-center">
                            <h4 class="text-primary mb-0"><%= questions.length %></h4>
                            <small class="text-muted">Total Questions</small>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="text-center">
                            <h4 class="text-info mb-0"><%= questions.filter(q => q.objective === 'reminding').length %></h4>
                            <small class="text-muted">Reminding (need 4)</small>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="text-center">
                            <h4 class="text-success mb-0"><%= questions.filter(q => q.objective === 'understanding').length %></h4>
                            <small class="text-muted">Understanding (need 4)</small>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="text-center">
                            <h4 class="text-warning mb-0"><%= questions.filter(q => q.objective === 'creativity').length %></h4>
                            <small class="text-muted">Creativity (need 4)</small>
                        </div>
                    </div>
                </div>
                <div class="progress mt-3">
                    <div class="progress-bar" role="progressbar" style="width: <%= (questions.length / 12) * 100 %>%">
                        <%= questions.length %> / 12
                    </div>
                </div>
            </div>
        </div>

        <!-- Questions by Objective Type -->
        <% ['reminding', 'understanding', 'creativity'].forEach(objective => { %>
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="card-title mb-0">
                        <% if (objective === 'reminding') { %>
                            <i class="fas fa-brain me-2 text-info"></i>Reminding Questions
                        <% } else if (objective === 'understanding') { %>
                            <i class="fas fa-lightbulb me-2 text-success"></i>Understanding Questions
                        <% } else { %>
                            <i class="fas fa-magic me-2 text-warning"></i>Creativity Questions
                        <% } %>
                        <span class="badge bg-<%= objective === 'reminding' ? 'info' : objective === 'understanding' ? 'success' : 'warning' %> ms-2">
                            <%= questions.filter(q => q.objective === objective).length %> / 4
                        </span>
                    </h5>
                </div>
                <div class="card-body">
                    <% const objectiveQuestions = questions.filter(q => q.objective === objective); %>
                    <% if (objectiveQuestions.length > 0) { %>
                        <div class="row">
                            <% objectiveQuestions.forEach(question => { %>
                                <div class="col-md-6 mb-3">
                                    <div class="card">
                                        <div class="card-body">
                                            <div class="d-flex justify-content-between align-items-start mb-2">
                                                <span class="badge bg-secondary">
                                                    Difficulty: <%= question.difficulty %>
                                                </span>
                                                <div class="btn-group btn-group-sm">
                                                    <a href="/questions/<%= question._id %>" class="btn btn-outline-primary">
                                                        <i class="fas fa-eye"></i>
                                                    </a>
                                                    <a href="/questions/<%= question._id %>/edit" class="btn btn-outline-secondary">
                                                        <i class="fas fa-edit"></i>
                                                    </a>
                                                    <form action="/questions/<%= question._id %>?_method=DELETE" method="POST" class="d-inline">
                                                        <button type="submit" class="btn btn-outline-danger btn-sm" onclick="return confirm('Are you sure you want to delete this question?')">
                                                            <i class="fas fa-trash"></i>
                                                        </button>
                                                    </form>
                                                </div>
                                            </div>
                                            <p class="card-text"><%= question.text.substring(0, 100) %><%= question.text.length > 100 ? '...' : '' %></p>
                                            <small class="text-muted">
                                                <i class="fas fa-clock me-1"></i>
                                                Created: <%= new Date(question.createdAt).toLocaleDateString() %>
                                            </small>
                                        </div>
                                    </div>
                                </div>
                            <% }); %>
                        </div>
                    <% } else { %>
                        <div class="text-center py-3">
                            <i class="fas fa-question-circle fa-2x text-muted mb-2"></i>
                            <p class="text-muted">No <%= objective %> questions yet</p>
                            <a href="/questions/create/<%= chapter.courseId._id %>/<%= chapter.number %>?objective=<%= objective %>" class="btn btn-outline-primary">
                                <i class="fas fa-plus me-2"></i>Add <%= objective.charAt(0).toUpperCase() + objective.slice(1) %> Question
                            </a>
                        </div>
                    <% } %>
                </div>
            </div>
        <% }); %>

        <!-- Quick Actions -->
        <div class="card">
            <div class="card-header">
                <h5 class="card-title mb-0">
                    <i class="fas fa-bolt me-2"></i>Quick Actions
                </h5>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-4">
                        <a href="/questions/create/<%= chapter.courseId._id %>/<%= chapter.number %>?objective=reminding" class="btn btn-info w-100 mb-2">
                            <i class="fas fa-brain me-2"></i>Add Reminding Question
                        </a>
                    </div>
                    <div class="col-md-4">
                        <a href="/questions/create/<%= chapter.courseId._id %>/<%= chapter.number %>?objective=understanding" class="btn btn-success w-100 mb-2">
                            <i class="fas fa-lightbulb me-2"></i>Add Understanding Question
                        </a>
                    </div>
                    <div class="col-md-4">
                        <a href="/questions/create/<%= chapter.courseId._id %>/<%= chapter.number %>?objective=creativity" class="btn btn-warning w-100 mb-2">
                            <i class="fas fa-magic me-2"></i>Add Creativity Question
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>