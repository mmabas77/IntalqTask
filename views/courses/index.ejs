<div class="row">
    <div class="col-12">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1 class="h3">
                <i class="fas fa-book me-2"></i>Courses
            </h1>
            <a href="/courses/create" class="btn btn-primary">
                <i class="fas fa-plus me-2"></i>Create New Course
            </a>
        </div>

        <% if (courses && courses.length > 0) { %>
            <div class="row">
                <% courses.forEach(course => { %>
                    <div class="col-md-6 col-lg-4 mb-4">
                        <div class="card h-100">
                            <div class="card-body">
                                <h5 class="card-title">
                                    <i class="fas fa-graduation-cap me-2 text-primary"></i>
                                    <%= course.name %>
                                </h5>
                                <p class="card-text text-muted">
                                    <i class="fas fa-book-open me-2"></i>
                                    <%= course.numberOfChapters %> chapters
                                </p>
                                <p class="card-text text-muted">
                                    <i class="fas fa-question-circle me-2"></i>
                                    <%= course.chapters ? course.chapters.reduce((total, chapter) => total + (chapter.questions ? chapter.questions.length : 0), 0) : 0 %> questions
                                </p>
                                <div class="progress mb-3">
                                    <% const completedChapters = course.chapters ? course.chapters.filter(chapter => chapter.questions && chapter.questions.length === 12).length : 0 %>
                                    <% const progressPercentage = (completedChapters / course.numberOfChapters) * 100 %>
                                    <div class="progress-bar" role="progressbar" style="width: <%= progressPercentage %>%">
                                        <%= Math.round(progressPercentage) %>%
                                    </div>
                                </div>
                                <small class="text-muted">
                                    <%= completedChapters %> of <%= course.numberOfChapters %> chapters completed
                                </small>
                            </div>
                            <div class="card-footer bg-transparent">
                                <div class="btn-group w-100" role="group">
                                    <a href="/courses/<%= course._id %>" class="btn btn-outline-primary">
                                        <i class="fas fa-eye me-1"></i>View
                                    </a>
                                    <a href="/courses/<%= course._id %>/edit" class="btn btn-outline-secondary">
                                        <i class="fas fa-edit me-1"></i>Edit
                                    </a>
                                    <form action="/courses/<%= course._id %>?_method=DELETE" method="POST" class="d-inline">
                                        <button type="submit" class="btn btn-outline-danger" onclick="return confirm('Are you sure you want to delete this course?')">
                                            <i class="fas fa-trash me-1"></i>Delete
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                <% }); %>
            </div>
        <% } else { %>
            <div class="text-center py-5">
                <i class="fas fa-book fa-3x text-muted mb-3"></i>
                <h4 class="text-muted">No courses available</h4>
                <p class="text-muted">Create your first course to get started with the exam design system.</p>
                <a href="/courses/create" class="btn btn-primary">
                    <i class="fas fa-plus me-2"></i>Create First Course
                </a>
            </div>
        <% } %>
    </div>
</div>