<div class="row">
    <div class="col-12">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1 class="h3">
                <i class="fas fa-clipboard-list me-2"></i>Exams
            </h1>
            <a href="/exams/create" class="btn btn-primary">
                <i class="fas fa-plus me-2"></i>Create New Exam
            </a>
        </div>

        <% if (exams && exams.length > 0) { %>
            <div class="row">
                <% exams.forEach(exam => { %>
                    <div class="col-md-6 col-lg-4 mb-4">
                        <div class="card h-100">
                            <div class="card-body">
                                <h5 class="card-title">
                                    <i class="fas fa-file-alt me-2 text-primary"></i>
                                    <%= exam.title %>
                                </h5>
                                <p class="card-text text-muted">
                                    <i class="fas fa-book me-2"></i>
                                    Course: <%= exam.courseId.name %>
                                </p>
                                <p class="card-text text-muted">
                                    <i class="fas fa-question-circle me-2"></i>
                                    <%= exam.selectedQuestions.length %> questions
                                </p>
                                <p class="card-text text-muted">
                                    <i class="fas fa-chart-pie me-2"></i>
                                    Course: <%= exam.courseId.name %>
                                </p>
                                <p class="card-text text-muted">
                                    <i class="fas fa-calendar me-2"></i>
                                    Created: <%= new Date(exam.createdAt).toLocaleDateString() %>
                                </p>
                                
                                <div class="mt-3">
                                    <span class="badge bg-info me-2">
                                        <i class="fas fa-brain me-1"></i>
                                        <%= exam.selectedQuestions.filter(q => q.questionId.objective === 'reminding').length %> Reminding
                                    </span>
                                    <span class="badge bg-success me-2">
                                        <i class="fas fa-lightbulb me-1"></i>
                                        <%= exam.selectedQuestions.filter(q => q.questionId.objective === 'understanding').length %> Understanding
                                    </span>
                                    <span class="badge bg-warning">
                                        <i class="fas fa-magic me-1"></i>
                                        <%= exam.selectedQuestions.filter(q => q.questionId.objective === 'creativity').length %> Creativity
                                    </span>
                                </div>
                            </div>
                            <div class="card-footer bg-transparent">
                                <div class="btn-group w-100" role="group">
                                    <a href="/exams/<%= exam._id %>" class="btn btn-outline-primary">
                                        <i class="fas fa-eye me-1"></i>View
                                    </a>
                                    <a href="/exams/<%= exam._id %>/export" class="btn btn-outline-success">
                                        <i class="fas fa-download me-1"></i>Export
                                    </a>
                                    <form action="/exams/<%= exam._id %>?_method=DELETE" method="POST" class="d-inline">
                                        <button type="submit" class="btn btn-outline-danger" onclick="return confirm('Are you sure you want to delete this exam?')">
                                            <i class="fas fa-trash me-1"></i>Delete
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                <% }); %>
            </div>
        <% } else { %>
            <div class="text-center py-5">
                <i class="fas fa-clipboard-list fa-3x text-muted mb-3"></i>
                <h4 class="text-muted">No exams available</h4>
                <p class="text-muted">Create your first exam to start testing students.</p>
                <a href="/exams/create" class="btn btn-primary">
                    <i class="fas fa-plus me-2"></i>Create First Exam
                </a>
            </div>
        <% } %>
    </div>
</div>